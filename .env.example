# Copy to .env and edit. Every setting Takt reads is listed here.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=takt.plant.local,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://takt.plant.local,http://localhost:8000
POSTGRES_DB=takt
POSTGRES_USER=takt
POSTGRES_PASSWORD=change-me
# Host port for the web container.
TAKT_HTTP_PORT=8000
# Plant timezone for the scheduler's cron times (02:00 nightly re-read).
TAKT_PLANT_TZ=America/Chicago
# Timezone for showing times in the UI. Each hub's MES timezone is set per hub in the admin.
TAKT_DISPLAY_TIMEZONE=America/Chicago
GUNICORN_WORKERS=3
TAKT_LOG_LEVEL=INFO
